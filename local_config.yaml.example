---
config:
  background: ""
  hwmon: 1
  wlan_interface: wlan0
  eth_interface: eth0
  euro: false
  copilot: false
  screen_off_timeout: 300
  colors:
    bg: "0f0f0f"
    fg: "e8e8e8"
    dim: "555555"
    critical_bg: "1a0a0a"
    critical_fg: "ff0000"
  monitors:
    laptop_output: eDP-1
    laptop_resolution: "1920x1080"
    docked_outputs:
      - name: DP-1
        resolution: "1920x1080"
        position: "0,0"
        scale: 1.0
        primary: true
