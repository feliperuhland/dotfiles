#!/bin/sh
# Put the machine to sleep, falling back to plain suspend when logind refuses
# (hibernation needs the swap file and resume= from `dotfiles system`); from a
# sway binding a refusal is otherwise silent.
#
# Usage: power-sleep            suspend, hibernate after HibernateDelaySec
#        power-sleep hibernate  hibernate now

verb=${1:-suspend-then-hibernate}
case "$verb" in
    suspend-then-hibernate|hibernate) ;;
    *) echo "Usage: power-sleep [hibernate]" >&2; exit 2 ;;
esac

err=$(systemctl "$verb" 2>&1) && exit 0

notify-send -u critical "systemctl $verb failed, suspending instead" \
    "${err:-no error message}"
exec systemctl suspend
