#!/bin/sh
set -e

REPO=$(dirname "$(realpath "$0")")

install_dotfiles() {
    mkdir -p "$HOME/.local/bin"
    ln -sf "$REPO/dotfiles" "$HOME/.local/bin/dotfiles"
    echo "Installed: $HOME/.local/bin/dotfiles -> $REPO/dotfiles"
}

sync_dotfiles() {
    ansible-playbook "$REPO/sync.yaml"
}

# Root-level config (lid, sleep, hibernation); asks for the sudo password.
system_dotfiles() {
    ansible-playbook --ask-become-pass "$REPO/system.yaml"
}

case "${1:-sync}" in
    install) install_dotfiles ;;
    sync)    sync_dotfiles ;;
    system)  system_dotfiles ;;
    *)       echo "Usage: dotfiles [install|sync|system]"; exit 1 ;;
esac
