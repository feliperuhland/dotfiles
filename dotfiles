#!/bin/sh
set -e

REPO=$(dirname "$(realpath "$0")")

LINK="$HOME/.local/bin/dotfiles"

install_dotfiles() {
    mkdir -p "$HOME/.local/bin"
    ln -sf "$REPO/dotfiles" "$LINK"
    echo "Installed: $LINK -> $REPO/dotfiles"
}

# Every run keeps the installed command pointing at this script, so pulling
# the repo is enough to update it (and a stale plain copy gets replaced).
ensure_installed() {
    [ "$(readlink "$LINK" 2>/dev/null)" = "$REPO/dotfiles" ] || install_dotfiles
}

sync_dotfiles() {
    ansible-playbook "$REPO/sync.yaml"
}

# Root-level config (lid, sleep, hibernation); asks for the sudo password.
system_dotfiles() {
    ansible-playbook --ask-become-pass "$REPO/system.yaml"
}

case "${1:-sync}" in
    install) install_dotfiles ;;
    sync)    ensure_installed; sync_dotfiles ;;
    system)  ensure_installed; system_dotfiles ;;
    *)       echo "Usage: dotfiles [install|sync|system]"; exit 1 ;;
esac
