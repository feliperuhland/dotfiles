* {
    font-family: monospace;
    font-size: 12px;
    font-variant: small-caps;
    border: none;
    border-radius: 0;
    padding: 0;
    margin: 0;
    min-height: 0;
}

window#waybar {
    background-color: #{{ config.colors.bg }};
    color: #{{ config.colors.fg }};
}

#workspaces button {
    padding: 0 6px;
    color: #{{ config.colors.dim }};
    background: transparent;
}

#workspaces button.focused {
    color: #{{ config.colors.fg }};
}

#workspaces button:hover {
    background: #1e1e1e;
    color: #888888;
}

#custom-os,
#mode,
#clock,
#network,
#battery,
#cpu,
#memory,
#disk,
#temperature,
#pulseaudio,
#custom-updates,
#tray {
    padding: 0 8px;
    color: #{{ config.colors.fg }};
}

#clock {
    font-weight: bold;
}

#temperature.critical {
    background-color: #{{ config.colors.critical_bg }};
}

#battery.critical:not(.charging) {
    color: #{{ config.colors.critical_fg }};
    background-color: #{{ config.colors.critical_bg }};
    animation: blink-red 1s linear infinite alternate;
}

@keyframes blink-red {
    to {
        background-color: #{{ config.colors.critical_fg }};
        color: #{{ config.colors.bg }};
    }
}

#tray {
    padding: 0 4px;
}
