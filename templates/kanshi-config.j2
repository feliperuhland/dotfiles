# Profiles must say enable/disable explicitly: kanshi otherwise keeps an
# output's current state, so undocking left the laptop panel disabled.
profile "undocked" {
    output {{ config.monitors.laptop_output }} enable mode {{ config.monitors.laptop_resolution }} position 0,0
}

# Laptop plus any one other display (projector, TV): mirror nothing, just
# enable both and let sway place the external one.
profile "external" {
    output {{ config.monitors.laptop_output }} enable mode {{ config.monitors.laptop_resolution }} position 0,0
    output * enable
}

profile "docked" {
    output {{ config.monitors.laptop_output }} disable
{% for m in config.monitors.docked_outputs %}
    output {{ m.name }} enable mode {{ m.resolution }} position {{ m.position }}{% if m.scale is defined %} scale {{ m.scale }}{% endif %}{% if m.transform is defined %} transform {{ m.transform }}{% endif %}

{% endfor %}
{% for m in config.monitors.docked_outputs %}
{% if m.primary is defined and m.primary %}
    exec swaymsg focus output {{ m.name }}
{% endif %}
{% endfor %}
}
