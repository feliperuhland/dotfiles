sort=-time
layer=overlay
background-color=#{{ config.colors.bg }}
text-color=#{{ config.colors.fg }}
width=300
height=110
border-size=0
border-radius=6
icons=1
max-icon-size=32
default-timeout=5000
ignore-timeout=1
font=Monospace 12
margin=10

[urgency=low]
background-color=#{{ config.colors.bg }}
text-color=#{{ config.colors.dim }}

[urgency=normal]
background-color=#{{ config.colors.bg }}
text-color=#{{ config.colors.fg }}

[urgency=high]
background-color=#{{ config.colors.critical_bg }}
text-color=#{{ config.colors.fg }}
default-timeout=0
