#!/bin/sh
set -e

DATA=$(curl -fsS "https://api.open-meteo.com/v1/forecast?latitude=52.3676&longitude=4.9041&current=temperature_2m,precipitation&timezone=Europe%2FAmsterdam")
TEMP=$(printf '%s' "$DATA" | jq -r '.current.temperature_2m')
RAIN=$(printf '%s' "$DATA" | jq -r '.current.precipitation')

echo "ams ${TEMP}c ${RAIN}mm"
